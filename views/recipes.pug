extends layout

block head
  link(rel='stylesheet' type='text/css' href='stylesheets/recipes.css')

block javascript
  script(src='javascripts/recipes.js')

block content
  div.container.mt-5
    div.row
      div.col-lg-2.list-group
        each course, index in courses
          a.list-group-item.list-group-item-action(href='#' + course._id, data-target="#recipes-carousel",
            data-slide-to=index, class=index==0?'active':'') #{course._id}

      div.col-lg-10
        div#recipes-carousel.carousel.slide
          div.carousel-inner
            each course, index in courses
              div.recipe-list.card.carousel-item(class=index==0?'active':'')
                div.card-header
                  div.row.align-items-center
                    div.col-11
                      h2(style='margin-bottom: 0px') #{course._id}
                    div.col-1
                      a(href='recipe/create/')
                        i.fa.fa-plus.fa-lg
                ul.list-group.list-group-flush
                  each recipe in course.recipes
                    li.list-group-item.d-flex.align-items-center.justify-content-between
                      a(href=recipe.url)= recipe.name
                      span.tools
                        button
                          i.fa.fa-edit.fa-lg
                        button.btn(type='button'
                          data-toggle='modal'
                          data-target='#deleteModal'
                          data-recipename=`${recipe.name}`
                          data-url=`/recipe/${recipe._id}/delete`
                          )
                          i.fa.fa-trash.fa-lg

  div#deleteModal.modal.fade(tabindex='-1' role='dialog' aria-labelledby='deleteModalLabel' aria-hidden='true')
    .modal-dialog(role='document')
      .modal-content
        .modal-header
          h5.modal-title#deleteModalLabel Confirm
          button.close(type='button' data-dismiss='modal' aria-label='Close')
            span(aria-hidden='true')
        .modal-body.

          Delete the recipe?

        .modal-footer
          form#deleteForm(action='' method='post')
            input(type='hidden' name='id')
            button.btn.btn-secondary(type='button' data-dismiss='modal') Cancel
            button.btn.btn-danger(type='submit') Delete
