extends layout

block javascript
  script(src='/javascripts/recipe_form.js')

block content
  div.container
    h1 #{title}

    form#theform(method='POST' action='')
      div.form-group.row
        label.col-sm-2.col-form-label(for='name') Name:
        div.col-sm-10
          input#name.form-control(type='text'
                                  name='name'
                                  required
                                  value=(undefined===recipe ? '' : recipe.name))
      div.form-group.row
        label.col-sm-2.col-form-label(for='servings') Number of servings:
        div.col-sm-10
          input#servings.form-control(type='number'
                                      min=1
                                      max=99
                                      name='servings'
                                      required
                                      value=(undefined===recipe ? '' : recipe.servings))
      div.form-group.row
        label.col-sm-2.col-form-label(for='course') Course:
        div.col-sm-10
          select#course.form-control(type='text'
                                    name='course'
                                    value=(undefined===recipe ? '' : recipe.course))
            each course in courses
              option(value=course) #{course}
      div.form-group.row
        label.col-sm-2.col-form-label(for='category') Category:
        div.col-sm-10
          select#category.form-control(type='select'
                                      placeholder='Select category'
                                      name='category'
                                      value=(undefined===recipe ? '' : recipe.category))
            each category in categories
              option(value=category) #{category}
      div.form-group.row
        label.col-sm-2.col-form-label(for='servedWith') Served with:
        div.col-sm-10
          select#recipe.form-control(type='select'
                                    placeholder='Select sides'
                                    name='servedWith')
            - recipe_list.sort(function(a, b) {let textA = a.name.toUpperCase(); let textB = b.name.toUpperCase(); return (textA < textB) ? -1 : (textA > textB) ? 1 : 0;});
            each recipe in recipe_list
              option(value=recipe._id) #{recipe.name}
          //-   if recipeinstance
          //-     option(value=recipe._id selected=(recipeinstance.recipe.toString()==recipe._id.toString() ? 'selected' : false)) #{recipe.title}
          //-   else
      div.form-group.row
        label.col-sm-2.col-form-label(for='ingredients') Ingredients:
        div.col-sm-9
          input#ingredients-input.form-control(type='text'
                                               value=(undefined===recipe ? '' : recipe.ingredients)
                                              )
          ul.mt-sm-3#ingredients-list
        div.col-sm-1
          button#ingredients-add.btn.btn-primary(type='button') Add


      div.form-group.row
        label.col-sm-2.col-form-label(for='instructions') Instructions:
        div.col-sm-10
          textarea#instructions.form-control(name='instructions' rows=10)=(undefined===recipe ? '' : recipe.instructions)
      div.text-center
        button.btn.btn-primary.text-center(type='submit') Submit

  if errors
    ul
      for error in errors
        li!= error.msg
