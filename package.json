{
  "name": "a",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node ./bin/www",
    "debug": "npm-run-all -p -r nodemon ui",
    "nodemon": "nodemon --nolazy --inspect=9229 ./bin/www",
    "ui": "browser-sync start --proxy='localhost:3000' --port 3001 --files='**/*.css, **/*.pug, **/*.js' --ignore=node_modules --reload-delay 10 --no-ui --no-notify",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "async": "^3.1.1",
    "cookie-parser": "~1.4.4",
    "debug": "~2.6.9",
    "dotenv": "^8.2.0",
    "express": "~4.16.1",
    "express-session": "^1.17.0",
    "express-validator": "^6.4.0",
    "glob": "^7.1.6",
    "http-errors": "~1.6.3",
    "mongoose": "^5.8.10",
    "morgan": "~1.9.1",
    "passport": "^0.4.1",
    "passport-auth0": "^1.3.2",
    "pug": "^2.0.4"
  },
  "devDependencies": {
    "babel-eslint": "^9.0.0",
    "browser-sync": "^2.26.7",
    "eslint": "^5.16.0",
    "eslint-config-airbnb": "^17.1.1",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^4.3.0",
    "eslint-config-wesbos": "0.0.19",
    "eslint-plugin-html": "^5.0.5",
    "eslint-plugin-import": "^2.20.1",
    "eslint-plugin-jsx-a11y": "^6.2.3",
    "eslint-plugin-prettier": "^3.1.2",
    "eslint-plugin-react": "^7.18.2",
    "eslint-plugin-react-hooks": "^1.7.0",
    "nodemon": "^2.0.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^1.19.1"
  }
